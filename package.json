{
  "name": "gd-measurements",
  "description": "Set of React components to add measurement means to your components for debugging purpose.",
  "version": "0.5.1",
  "type": "module",
  "main": "dist/gd-measurements.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "author": {
    "name": "Łukasz Grela",
    "email": "lukasz.grela@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukaszGrela/gd-measurements.git"
  },
  "bugs": {
    "url": "https://github.com/LukaszGrela/gd-measurements/issues"
  },
  "scripts": {
    "clean-package": "node scripts/clean-package.js",
    "dev": "vite",
    "build": "tsc --p ./tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "build-examples": "vite build --base=/gd-measurements/ --config vite.example.config.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "prepack": "npm run build && npm run clean-package",
    "postpack": "node scripts/restore-package.js",
    "prepublishOnly": "npm run verify",
    "typecheck": "tsc --p ./tsconfig.lib.json && tsc --p ./tsconfig.app.json && tsc --p ./tsconfig.node.json",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@microsoft/api-extractor": "^7.60.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.66.1",
    "sass": "^1.90.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "minimatch": "^11.0.9"
  }
}
